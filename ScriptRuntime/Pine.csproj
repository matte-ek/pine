<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Pine</AssemblyName>
        <RootNamespace>Pine</RootNamespace>

        <!-- The engine calls native code through delegate* unmanaged<> function pointers, and
             exposes its own entry points with [UnmanagedCallersOnly] - see Pine.Core.Interop. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- The engine hosts this assembly rather than launching it, so it needs the
             runtimeconfig.json that hostfxr starts the runtime from. Only a project marked for
             dynamic loading emits one. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>

        <!-- Pine::Script::Runtime::Setup loads engine/script/Pine.dll by a path with no framework
             segment in it, so the output must not grow a net10.0/ folder to sit in. -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>../data/engine/script/</OutputPath>
    </PropertyGroup>

</Project>
