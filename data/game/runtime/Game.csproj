<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Game</AssemblyName>
        <RootNamespace>game</RootNamespace>

        <!-- The editor loads <project>/runtime-bin/Game.dll by a path with no framework segment
             in it, so the output must not grow a net10.0/ folder to sit in. -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>../runtime-bin/</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <!-- Gameplay scripts live next to their .passet in the project's assets/ tree. -->
        <Compile Include="..\assets\**\*.cs">
            <Link>Scripts\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <!-- Not copied beside Game.dll. The engine loads Pine.dll once into the default load
             context, and the collectible context this assembly lands in resolves it from there;
             a local copy would be loaded a second time, and this project's Script base class
             would stop being the same type as the engine's. -->
        <Reference Include="Pine">
            <HintPath>..\..\..\engine\script\Pine.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
